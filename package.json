{
  "name": "cpmaster-studio",
  "version": "1.0.0",
  "private": true,
  "description": "CPMaster Studio: makes Историк videos on the phone from Gemini and ElevenLabs keys",
  "scripts": {
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/mp4-muxer/build/mp4-muxer.mjs','www/vendor/mp4-muxer.mjs')\" && esbuild tools/three-entry.mjs --bundle --format=esm --minify --target=es2020 --outfile=www/vendor/three.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "serve": "node tools/serve.mjs",
    "android": "npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "mp4-muxer": "5.2.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "esbuild": "0.25.10"
  }
}
